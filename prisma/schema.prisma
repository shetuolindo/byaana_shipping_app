generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

enum OrderSource {
  SHOPIFY
  MANUAL
  REPLACEMENT
}

enum OrderStatus {
  NEW
  ON_HOLD
  READY
  PROCESSING
  SHIPPED
  CANCELLED
  ERROR
}

enum Carrier {
  SGS
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  CANCELLED
  ERROR
}

model User {
  id                 String               @id @default(cuid())
  name               String
  email              String               @unique
  passwordHash       String
  role               UserRole
  orderStatusHistory OrderStatusHistory[]
  auditLogs          AuditLog[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Shop {
  id                          String    @id @default(cuid())
  name                        String
  shopifyShopDomain           String    @unique
  shopifyAccessTokenEncrypted String?
  shopifyConnectedAt          DateTime?
  isActive                    Boolean   @default(true)
  orders                      Order[]
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

model Order {
  id                       String               @id @default(cuid())
  orderNumber              String               @unique
  shopId                   String?
  parentOrderId            String?
  source                   OrderSource
  internalStatus           OrderStatus          @default(NEW)
  shopifyOrderId           String?              @unique
  shopifyOrderNumber       String?
  externalCreatedAt        DateTime?
  shopifyUpdatedAt         DateTime?
  shopifyFinancialStatus   String?
  shopifyFulfillmentStatus String?
  shopifyCancelledAt       DateTime?
  shopifyCancelReason      String?
  customerName             String?
  customerEmail            String?
  customerPhone            String?
  currency                 String?
  subtotal                 Decimal?             @db.Decimal(12, 2)
  shippingAmount           Decimal?             @db.Decimal(12, 2)
  taxAmount                Decimal?             @db.Decimal(12, 2)
  totalAmount              Decimal?             @db.Decimal(12, 2)
  notes                    String?
  holdReason               String?
  errorMessage             String?
  shop                     Shop?                @relation(fields: [shopId], references: [id], onDelete: SetNull)
  parentOrder              Order?               @relation("OrderReplacements", fields: [parentOrderId], references: [id], onDelete: SetNull)
  replacements             Order[]              @relation("OrderReplacements")
  address                  Address?
  items                    OrderItem[]
  shipments                Shipment[]
  statusHistory            OrderStatusHistory[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([shopId])
  @@index([parentOrderId])
  @@index([shopifyOrderNumber])
  @@index([customerName])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([internalStatus])
  @@index([createdAt])
}

model Address {
  id          String   @id @default(cuid())
  orderId     String   @unique
  name        String?
  company     String?
  phone       String?
  email       String?
  countryCode String?
  province    String?
  city        String?
  district    String?
  address1    String?
  address2    String?
  postalCode  String?
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  shopifyLineItemId String?
  sku               String?
  sgsSku            String?
  name              String
  quantity          Int
  unitPrice         Decimal? @db.Decimal(12, 2)
  declaredValue     Decimal? @db.Decimal(12, 2)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([orderId, shopifyLineItemId])
  @@index([orderId])
}

model Shipment {
  id                      String          @id @default(cuid())
  orderId                 String
  carrier                 Carrier
  internalStatus          ShipmentStatus  @default(PENDING)
  carrierOrderCode        String?
  carrierReferenceNo      String
  carrierStatus           String?
  carrierSubStatus        String?
  allocationStatus        String?
  warehouseCode           String
  shippingMethodCode      String
  trackingNumber          String?
  shippingCost            Decimal?        @db.Decimal(12, 2)
  totalCarrierCost        Decimal?        @db.Decimal(12, 2)
  carrierCurrency         String?
  cancelStatus            String?
  cancellationReason      String?
  cancellationRequestedAt DateTime?
  cancellationResolvedAt  DateTime?
  labelLastFetchedAt      DateTime?
  lastCarrierSyncAt       DateTime?
  carrierCreatedAt        DateTime?
  carrierShippedAt        DateTime?
  lastErrorCode           String?
  lastErrorMessage        String?
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  trackingEvents          TrackingEvent[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@unique([carrier, carrierReferenceNo])
  @@unique([carrier, carrierOrderCode])
  @@index([orderId])
  @@index([trackingNumber])
  @@index([carrierOrderCode])
  @@index([carrierReferenceNo])
  @@index([internalStatus])
  @@index([carrierStatus])
  @@index([carrier, carrierStatus])
}

model TrackingEvent {
  id               String    @id @default(cuid())
  shipmentId       String
  carrierEventCode String?
  status           String?
  description      String?
  location         String?
  eventAt          DateTime?
  rawFingerprint   String?
  shipment         Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now())

  @@unique([shipmentId, rawFingerprint])
  @@index([shipmentId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  reason      String?
  actorUserId String?
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([orderId])
  @@index([actorUserId])
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String?
  status          String
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  errorMessage    String?
  payload         Json?

  @@unique([provider, externalEventId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([actorUserId])
}

model ShippingMethod {
  id            String   @id @default(cuid())
  carrier       Carrier
  warehouseCode String?
  code          String
  name          String
  nameEn        String?
  isActive      Boolean  @default(true)
  lastSyncedAt  DateTime @default(now())

  @@unique([carrier, warehouseCode, code])
}

model Warehouse {
  id            String   @id @default(cuid())
  carrier       Carrier
  code          String
  name          String?
  countryCode   String?
  carrierStatus String?
  isActive      Boolean  @default(true)
  lastSyncedAt  DateTime @default(now())

  @@unique([carrier, code])
}
